@@ -2,0 +3,13 @@
+#[repr(C)]
+struct TimeSpec { seconds: std::ffi::c_long, nanoseconds: std::ffi::c_long }
+
+unsafe extern "C" {
+    fn clock_gettime(clock_id: std::ffi::c_int, time: *mut TimeSpec) -> std::ffi::c_int;
+}
+
+fn thread_cpu_ms() -> f64 {
+    let mut time = TimeSpec { seconds: 0, nanoseconds: 0 };
+    assert_eq!(unsafe { clock_gettime(3, &mut time) }, 0); // Linux CLOCK_THREAD_CPUTIME_ID
+    time.seconds as f64 * 1e3 + time.nanoseconds as f64 / 1e6
+}
