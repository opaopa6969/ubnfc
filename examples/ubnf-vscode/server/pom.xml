<?xml version="1.0" encoding="UTF-8"?>
<!--
  UBNF の LSP サーバ（VSIX に同梱する fat jar）。
  ソースは 100% 生成物: ubnfc-java が出すパーサ + ubnfc-lsp が出す LSP 包み + extern scanner。
  scripts/build-vsix.sh が target/generated-sources/ubnfc に書いてから、この pom を叩く。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.unlaxer</groupId>
  <artifactId>ubnfc-ubnf-lsp-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>ubnfc-ubnf-lsp-server</name>
  <description>ubnfc が UBNF 自身の文法から生成したパーサを包む LSP サーバ</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 旧スタック（ubnf-vscode / tinyexpression-p4-lsp-vscode）と同じ版に揃える。 -->
    <lsp4j.version>0.23.1</lsp4j.version>
    <junit.version>5.10.2</junit.version>
    <!--
      DAP（文法デバッガ）は opt-in。`-Pdap` を付けたときだけ lsp4j.debug を引き、
      src/test/java/**/dap/** をコンパイルする。付けなければ jar も依存も今までどおり
      （`scripts/build-vsix.sh` の with-dap 指定がこの profile と生成側の dap 出力を一緒に有効にする）。
    -->
    <dap.test.excludes>**/dap/**</dap.test.excludes>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j</artifactId>
      <version>${lsp4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j.jsonrpc</artifactId>
      <version>${lsp4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>ubnfc-ubnf-lsp-server</finalName>
    <!-- 生成物だけをコンパイルする。リポジトリに Java ソースは 1 本も置かない（テストを除く）。 -->
    <sourceDirectory>${project.build.directory}/generated-sources/ubnfc</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.3.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration>
          <testExcludes><testExclude>${dap.test.excludes}</testExclude></testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.unlaxer.ubnfc.examples.ubnf.lsp.ServerMain</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>dap</id>
      <properties>
        <!-- 何も除外しない（存在しないパターンを 1 つ置く） -->
        <dap.test.excludes>nothing/does/not/exist/**</dap.test.excludes>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.lsp4j</groupId>
          <artifactId>org.eclipse.lsp4j.debug</artifactId>
          <version>${lsp4j.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
