// macro は「引用を受け取って引用を返す、コンパイル時に走る語」。
// 語と構文は同じで、検査と実行の段が違う。これが stax の自己拡張の口である。

// unless は cond を反転して if_else に渡すだけの構文糖。
macro unless ( [ -- ] -- [ -- ] )
  let body
  [ not body [ ] choose call ] ;

: if_else ( Bool [ -- ] [ -- ] -- )
  choose call ;

: main ( -- )
  3 5 >
  [ "never" print ]
  unless
  call
  newline ;
