// RFC 8259 の JSON を UBNF v2 で書いたもの。
// 同じ言語を ANTLR (examples/json/antlr/JSON.g4) と tree-sitter
// (examples/json/treesitter/grammar.js) でも書いてある。3 記法の対応と、
// 揃えられなかった 1 点は examples/json/README.md を読むこと。
grammar Json {

  @ubnf: 2
  @package: org.example.json

  // 暗黙の trivia は使わない。@whitespace: javaStyle は `//` と `/* */` を必ず
  // 区切りに入れてしまい（crates/ubnfc-front/src/lower/trivia.rs:85-99）、JSON では
  // コメントが通ってしまう。さらに javaStyle は 0x0B/0x0C も空白扱いする。
  // RFC 8259 §2 の ws はちょうど 4 文字なので、Ws 規則として自分で書く。
  @whitespace: none

  // @literalBoundary は v2 既定の word のまま。'true' / 'false' / 'null' が
  // `truex` のような入力で語境界により失敗する（crates/ubnfc-front/src/boundary.rs）。
  // ただし**英数字 1 文字のリテラル**（'0' 'e' 'u' 'b' …）も語境界の対象になり、
  // `0e1` や `é` を壊すので、そこだけ token にしてある（token は対象外）。

  token EOF     = END_OF_INPUT
  token DIGIT   = DIGIT              // [0-9]
  token HEX     = XDIGIT             // [0-9A-Fa-f]
  token ZERO    = CHAR_RANGE('0','0')
  token ONENINE = CHAR_RANGE('1','9')
  token E_LOWER = CHAR_RANGE('e','e')
  token E_UPPER = CHAR_RANGE('E','E')
  token ESC_B   = CHAR_RANGE('b','b')
  token ESC_F   = CHAR_RANGE('f','f')
  token ESC_N   = CHAR_RANGE('n','n')
  token ESC_R   = CHAR_RANGE('r','r')
  token ESC_T   = CHAR_RANGE('t','t')
  token ESC_U   = CHAR_RANGE('u','u')

  // 文字列の「生のまま置ける 1 文字」。RFC 8259 §7 は `"` `\` と **U+0000..U+001F** を
  // 除く任意の Unicode 文字、と定める。v2 の code point クラス（D-063）で正の範囲として
  // 素直に書ける:
  //   - CHAR_RANGE の境界に `\uXXXX` / `\u{X…}` を書ける（v2 のみ）
  //   - CHAR_RANGE の境界が BMP に限られない（v2 のみ。U+10FFFF まで）
  // surrogate 区画（U+D800..U+DFFF）は単独では文字ではないので範囲に含めない
  // （含む範囲は E-TOKEN-CHAR-RANGE-* が拒否する）。そのため上側は 2 つに割れる。
  token SAFE_SP   = CHAR_RANGE('\u0020','\u0021')        // U+0020..U+0021 ( `"` の手前まで )
  token SAFE_MID  = CHAR_RANGE('\u0023','\u005B')        // U+0023..U+005B ( `\` の手前まで )
  token SAFE_BMP  = CHAR_RANGE('\u005D','\u{D7FF}')      // U+005D..U+D7FF
  token SAFE_SUPP = CHAR_RANGE('\u{E000}','\u{10FFFF}')  // U+E000..U+10FFFF（補助面を含む）

  @root
  @mapping(JsonDocument, params=[value])
  Json ::= Ws Value @value Ws EOF ;

  // RFC 8259 §2: ws = *( %x20 / %x09 / %x0A / %x0D )
  Ws ::= { ' ' | '\t' | '\n' | '\r' } ;

  Value ::= Object | Array | String | Number | True | False | Null ;

  @mapping(ObjectNode, params=[members])
  Object ::= '{' Ws [ Member @members { Ws ',' Ws Member @members } Ws ] '}' ;

  @mapping(MemberNode, params=[key, value])
  Member ::= String @key Ws ':' Ws Value @value ;

  @mapping(ArrayNode, params=[items])
  Array ::= '[' Ws [ Value @items { Ws ',' Ws Value @items } Ws ] ']' ;

  @mapping(StringNode, params=[text])
  String ::= '"' ( { Char } ) @text '"' ;

  Char ::= Escape | SAFE_SP | SAFE_MID | SAFE_BMP | SAFE_SUPP ;

  // RFC 8259 §7 escape。\uXXXX はサロゲートの対を検査しない（3 記法とも同じ）。
  Escape ::= '\\' ( '"' | '\\' | '/' | ESC_B | ESC_F | ESC_N | ESC_R | ESC_T | ESC_U HEX{4} ) ;

  // RFC 8259 §6 number。先頭 + 、先頭 0 の連なり、先頭・末尾のドットは無い。
  @mapping(NumberNode, params=[text])
  Number ::= ( [ '-' ] Int [ Frac ] [ Exp ] ) @text ;

  Int  ::= ZERO | ONENINE { DIGIT } ;
  Frac ::= '.' DIGIT+ ;
  Exp  ::= ( E_LOWER | E_UPPER ) [ '+' | '-' ] DIGIT+ ;

  @mapping(TrueNode)  True  ::= 'true' ;
  @mapping(FalseNode) False ::= 'false' ;
  @mapping(NullNode)  Null  ::= 'null' ;
}
