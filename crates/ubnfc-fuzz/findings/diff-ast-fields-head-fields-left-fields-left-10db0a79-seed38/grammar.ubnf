grammar Fuzz {
  token T0 = EMPTY
  token T1 = UNTIL('#')
  token T2 = org.unlaxer.parser.clang.IdentifierParser
  L0 ::= ;
  @enum L1 ::= 'beta' | 'gamma';
  @recovery(SKIP) M0 ::= ',' L1*;
  @mapping(C1, params=[v2]) @whitespace M1 ::= ERROR('fuzz error'){1,3} @v2 L0{0,1};
  @interleave(profile=commentsAndSpaces) @scopeTree(mode=dynamic) @declares(symbol=v3) @backref(name=v7) M2 ::= ',' @v3 | [ T2 '+'+ % ':' ] | { M0? { M0{1,2} @v4 T1 @v5 }? 'x'{0,} @v6 } M1 @v7 'あ';
  @mapping(Bin0, params=[left, op, right]) @leftAssoc @precedence(level=90) Op0 ::= M2 @left { '*' @op M2 @right };
  @mapping(Bin1, params=[left, op, right]) @leftAssoc @precedence(level=80) Op1 ::= Op0 @left { '*' @op Op0 @right };
  @root @mapping(Top, params=[head, tail]) Root ::= Op1 @head ( ',' @tail T2{2} )* @tail;
}
