grammar Fuzz {
  @whitespace: javaStyle
  @package: fuzz.generated
  token T0 = NumberParser
  token T1 = NEGATION('ab\n')
  @enum L0 ::= 'alpha' | 'beta' | 'gamma';
  L1 ::= { T1 ':'{2,} } { ','{1,3} @v1 T0 }+ @v2 | L0 @v3 ERROR('fuzz error') T0? @v4;
  L2 ::= '😀' @v5 'a' @v6 'a' @v7;
  @mapping(C0, params=[v10, v8, v9]) @whitespace(none) @interleave(profile=javaStyle) M0 ::= ':'{2,4} [ 'c'+ @v8 ',' @v9 ] @v10;
  @mapping(C1, params=[v11]) @interleave(profile=commentsAndSpaces) M1 ::= 'あ'{2} @v11;
  @whitespace M2 ::= L1* | [ ',' ] '*' T0 @v12 | 'a' @v13;
  @mapping(Bin0, params=[left, op, right]) @leftAssoc @precedence(level=90) Op0 ::= L1 @left { '*' @op L1 @right };
  @root @mapping(Top, params=[head, tail]) Root ::= Op0 @head '='+ @head ( ',' @tail '😀' )* @tail;
}
