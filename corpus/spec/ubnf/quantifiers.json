        "file": "unlaxer-dsl/specs/ubnf-syntax.md",
        "heading": "## 形式的な文法定義",
        "sentence": "Quantifier ::= '+' | '?' | '*' | '{' INTEGER '}' | '{' INTEGER ',' [INTEGER] '}'"
      },
      "input": "grammar G { R ::= 'x'+; }",
      "expectation": {
        "verdict": "accept"
      }
    },
    {
